{
  "entities": {
    "sites_index": {
      "title": "Sites Index",
      "description": "Lightweight public index for map rendering, search, filters and zoom visibility.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "nameTR": {
          "type": "string"
        },
        "nameEN": {
          "type": "string"
        },
        "alternativeNamesTR": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternativeNamesEN": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "province": {
          "type": "string"
        },
        "district": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "siteType": {
          "type": "string"
        },
        "periodIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "startYear": {
          "type": [
            "number",
            "null"
          ]
        },
        "endYear": {
          "type": [
            "number",
            "null"
          ]
        },
        "importance": {
          "type": "number"
        },
        "minZoom": {
          "type": "number"
        },
        "featured": {
          "type": "boolean"
        },
        "storagePath": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "nameTR",
        "nameEN",
        "latitude",
        "longitude",
        "periodIds",
        "storagePath"
      ]
    },
    "research_queue": {
      "title": "Research Queue",
      "description": "Private queue for archaeological research and ingestion workers.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {},
        "province": {},
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "processing",
            "completed",
            "needs_review"
          ]
        },
        "assignedWorker": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "attemptCount": {
          "type": "number"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "research_jobs": {
      "title": "Research Jobs",
      "description": "Private ingestion job telemetry and validation outcomes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "workerId": {
          "type": "string"
        },
        "siteId": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "needs_review"
          ]
        },
        "validationErrors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storageUploaded": {
          "type": "boolean"
        },
        "storagePath": {
          "type": "string"
        },
        "sourceCount": {
          "type": "number"
        },
        "imageCount": {
          "type": "number"
        }
      }
    }
  },
  "storage": {
    "buckets": [
      {
        "name": "hiddenfeed.firebasestorage.app",
        "paths": {
          "atlas/sites/{siteId}.json": "Canonical full bilingual archaeological monograph JSON."
        }
      }
    ]
  }
}
