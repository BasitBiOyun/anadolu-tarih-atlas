rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sites_index/{siteId} {
      allow read: if true;
      allow write: if false;
    }

    match /research_queue/{queueId} {
      allow read: if true;
      allow write: if false;
    }

    match /research_jobs/{jobId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
